---
import Base from './Base.astro';
import CTABanner from '../components/CTABanner.astro';
import { BLOG, UI, NAV_LABELS, path, type Locale } from '../i18n/config';
import { ID } from '../i18n/seo';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  category: string;
  pubDate: Date;
  updatedDate?: Date;
  image: string;
  imageAlt: string;
  alternates: Record<Locale, string>;
  canonicalUrl: string;
}

const { locale, title, description, category, pubDate, updatedDate, image, imageAlt, alternates, canonicalUrl } = Astro.props;
const t = BLOG[locale];
const ui = UI[locale];
const intlLocale = locale === 'fr' ? 'fr-BE' : locale === 'nl' ? 'nl-BE' : 'en-GB';
const formattedPubDate = new Intl.DateTimeFormat(intlLocale, { dateStyle: 'long' }).format(pubDate);
const formattedUpdatedDate = updatedDate ? new Intl.DateTimeFormat(intlLocale, { dateStyle: 'long' }).format(updatedDate) : null;

const site = Astro.site?.origin ?? 'https://belcleanfac.be';
const articleNode = {
  '@type': 'BlogPosting',
  '@id': `${canonicalUrl}#article`,
  headline: title,
  description,
  image: new URL(image, site).toString(),
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  inLanguage: locale === 'fr' ? 'fr-BE' : locale === 'nl' ? 'nl-BE' : 'en',
  articleSection: category,
  author: { '@id': ID.org },
  publisher: { '@id': ID.org },
  isPartOf: { '@id': ID.website },
  mainEntityOfPage: { '@id': `${canonicalUrl}#webpage` },
};
const breadcrumb = [
  { name: NAV_LABELS[locale].home, path: path('home', locale) },
  { name: NAV_LABELS[locale].blog, path: path('blog', locale) },
  { name: title, path: alternates[locale] },
];
---

<Base
  locale={locale}
  page="blog"
  title={title}
  description={description}
  alternates={alternates}
  image={image}
  imageAlt={imageAlt}
  ogType="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate ?? pubDate}
  schema={[articleNode]}
  breadcrumb={breadcrumb}
>

  <section class="bg-brand-950 pt-32 pb-16">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
      <a href={path('blog', locale)} class="text-sm font-semibold text-brand-300 hover:text-white">&larr; {t.backToBlog}</a>
      <p class="mt-5 text-sm font-semibold uppercase tracking-[0.2em] text-brand-300">{category}</p>
      <h1 class="mt-3 text-3xl font-bold text-white sm:text-4xl">{title}</h1>
      <p class="mt-4 text-sm text-brand-200">
        {t.publishedOn} {formattedPubDate}
        {formattedUpdatedDate && <> &middot; {t.updatedOn} {formattedUpdatedDate}</>}
      </p>
    </div>
  </section>

  <div class="mx-auto -mt-10 max-w-4xl px-4 sm:px-6 lg:px-8">
    <img src={image} alt={imageAlt} fetchpriority="high" class="aspect-[16/9] w-full rounded-2xl object-cover shadow-lg" />
  </div>

  <article class="prose-blog mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <slot />
  </article>

  <CTABanner
    title={t.relatedCta}
    description={t.relatedCtaDescription}
    ctaLabel={ui.ctaQuote}
    ctaHref={path('contact', locale)}
    phoneLabel={ui.ctaCall}
    phone={ui.phone1}
  />
</Base>
