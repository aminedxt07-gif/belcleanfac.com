---
interface Props {
  image: string;
  title: string;
  description: string;
  href?: string;
  linkLabel?: string;
}

const { image, title, description, href, linkLabel } = Astro.props;
---

<div data-reveal class="group flex h-full flex-col overflow-hidden rounded-2xl border border-ink-900/5 bg-white shadow-sm shadow-ink-900/5 transition-shadow hover:shadow-lg hover:shadow-brand-900/10">
  <div class="aspect-[4/3] overflow-hidden">
    <img
      src={image}
      alt={title}
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
    />
  </div>
  <div class="flex flex-1 flex-col p-6">
    <h3 class="text-lg font-bold text-ink-900">{title}</h3>
    <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-700">{description}</p>
    {href && linkLabel && (
      <a href={href} class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 hover:text-brand-700">
        {linkLabel}
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    )}
  </div>
</div>
