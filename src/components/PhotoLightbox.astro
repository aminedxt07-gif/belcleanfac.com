---
interface Props {
  closeLabel?: string;
  prevLabel?: string;
  nextLabel?: string;
}

const { closeLabel = 'Fermer', prevLabel = 'Précédent', nextLabel = 'Suivant' } = Astro.props;
---

<div
  id="lightbox"
  class="fixed inset-0 z-[100] hidden items-center justify-center bg-ink-900/90 p-4 backdrop-blur-sm sm:p-8"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
>
  <button
    id="lightbox-close"
    type="button"
    aria-label={closeLabel}
    class="absolute right-4 top-4 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20 sm:right-6 sm:top-6"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  <div class="flex w-full max-w-4xl flex-col items-center">
    <p id="lightbox-title" class="mb-3 text-center text-sm font-semibold uppercase tracking-[0.15em] text-brand-300"></p>

    <div class="relative flex w-full items-center justify-center">
      <button
        id="lightbox-prev"
        type="button"
        aria-label={prevLabel}
        class="absolute left-0 z-10 flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20 sm:-left-4"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <div class="aspect-[4/3] w-full overflow-hidden rounded-2xl bg-ink-900 sm:aspect-[16/10]">
        <img id="lightbox-image" src="" alt="" class="h-full w-full object-contain" />
      </div>

      <button
        id="lightbox-next"
        type="button"
        aria-label={nextLabel}
        class="absolute right-0 z-10 flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20 sm:-right-4"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>

    <p id="lightbox-counter" class="mt-4 text-sm text-brand-200"></p>
  </div>
</div>

<script>
  const overlay = document.getElementById('lightbox') as HTMLElement | null;
  const imageEl = document.getElementById('lightbox-image') as HTMLImageElement | null;
  const titleEl = document.getElementById('lightbox-title');
  const counterEl = document.getElementById('lightbox-counter');
  const closeBtn = document.getElementById('lightbox-close');
  const prevBtn = document.getElementById('lightbox-prev');
  const nextBtn = document.getElementById('lightbox-next');

  let photos: string[] = [];
  let title = '';
  let index = 0;

  function render() {
    if (!imageEl || !titleEl || !counterEl) return;
    imageEl.src = photos[index];
    imageEl.alt = title;
    titleEl.textContent = title;
    counterEl.textContent = `${index + 1} / ${photos.length}`;
  }

  function open(newPhotos: string[], newTitle: string) {
    if (!overlay || newPhotos.length === 0) return;
    photos = newPhotos;
    title = newTitle;
    index = 0;
    render();
    overlay.classList.remove('hidden');
    overlay.classList.add('flex');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function close() {
    if (!overlay) return;
    overlay.classList.add('hidden');
    overlay.classList.remove('flex');
    overlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  function step(delta: number) {
    if (photos.length === 0) return;
    index = (index + delta + photos.length) % photos.length;
    render();
  }

  closeBtn?.addEventListener('click', close);
  prevBtn?.addEventListener('click', () => step(-1));
  nextBtn?.addEventListener('click', () => step(1));
  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) close();
  });
  document.addEventListener('keydown', (e) => {
    if (overlay?.classList.contains('hidden')) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') step(-1);
    if (e.key === 'ArrowRight') step(1);
  });

  document.querySelectorAll<HTMLElement>('[data-gallery-photos]').forEach((el) => {
    el.addEventListener('click', () => {
      const raw = el.getAttribute('data-gallery-photos');
      const galleryTitle = el.getAttribute('data-gallery-title') || '';
      if (!raw) return;
      try {
        const parsed = JSON.parse(raw) as string[];
        open(parsed, galleryTitle);
      } catch {
        // ignore malformed data
      }
    });
  });
</script>
