---
interface Stat {
  value: string;
  label: string;
}

interface Props {
  stats: Stat[];
}

const { stats } = Astro.props;
---

<section class="border-y border-brand-900/5 bg-brand-50">
  <div data-reveal-group class="mx-auto grid max-w-7xl grid-cols-2 gap-6 px-4 py-10 sm:px-6 lg:grid-cols-4 lg:px-8">
    {stats.map((s) => (
      <div data-reveal class="text-center">
        <p class="text-3xl font-extrabold text-brand-700 sm:text-4xl">{s.value}</p>
        <p class="mt-1 text-sm font-medium text-ink-700">{s.label}</p>
      </div>
    ))}
  </div>
</section>
