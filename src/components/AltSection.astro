---
interface Props {
  id?: string;
  image: string;
  eyebrow: string;
  title: string;
  description: string;
  points?: string[];
  reverse?: boolean;
  ctaLabel?: string;
  ctaHref?: string;
  tint?: boolean;
}

const { id, image, eyebrow, title, description, points = [], reverse = false, ctaLabel, ctaHref, tint = false } = Astro.props;
---

<section id={id} class:list={['scroll-mt-24 py-16 sm:py-20', tint ? 'bg-brand-50' : 'bg-white']}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class:list={['grid items-center gap-10 lg:grid-cols-2 lg:gap-16', reverse ? 'lg:[&>*:first-child]:order-2' : '']}>
      <div class="overflow-hidden rounded-3xl">
        <img src={image} alt={title} class="h-full w-full max-h-[480px] object-cover" loading="lazy" />
      </div>
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-600">{eyebrow}</p>
        <h2 class="mt-3 text-3xl font-bold text-ink-900 sm:text-4xl">{title}</h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-700">{description}</p>
        {points.length > 0 && (
          <ul class="mt-6 space-y-3">
            {points.map((p) => (
              <li class="flex items-start gap-3 text-sm text-ink-700">
                <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-5 w-5 shrink-0 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 12l5 5L20 7" />
                </svg>
                <span>{p}</span>
              </li>
            ))}
          </ul>
        )}
        {ctaLabel && ctaHref && (
          <a href={ctaHref} class="mt-8 inline-flex rounded-full bg-brand-600 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-700">
            {ctaLabel}
          </a>
        )}
      </div>
    </div>
  </div>
</section>
