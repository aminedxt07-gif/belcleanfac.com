---
interface Props {
  image: string;
  title: string;
  description: string;
  reference?: string;
}

const { image, title, description, reference } = Astro.props;
---

<div class="relative flex h-full flex-col overflow-hidden rounded-2xl border border-ink-900/5 bg-white shadow-sm shadow-ink-900/5">
  <div class="aspect-[16/10] overflow-hidden">
    <img src={image} alt={title} class="h-full w-full object-cover" loading="lazy" />
  </div>
  <div class="flex flex-1 flex-col p-6">
    <h2 class="text-lg font-bold text-ink-900">{title}</h2>
    <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-700">{description}</p>
    {reference && (
      <p class="mt-4 border-t border-ink-900/5 pt-3 text-xs font-semibold uppercase tracking-wide text-brand-600">
        {reference}
      </p>
    )}
  </div>
</div>
