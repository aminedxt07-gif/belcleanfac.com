---
interface Props {
  image: string;
  eyebrow: string;
  title: string;
  subtitle: string;
  ctaLabel: string;
  ctaHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const { image, eyebrow, title, subtitle, ctaLabel, ctaHref, secondaryLabel, secondaryHref } = Astro.props;
---

<section class="relative overflow-hidden bg-brand-950">
  <img
    src={image}
    alt=""
    fetchpriority="high"
    decoding="async"
    class="hero-image-enter absolute inset-0 h-full w-full object-cover"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-brand-950 via-brand-950/80 to-brand-950/40"></div>

  <div class="relative mx-auto max-w-7xl px-4 py-24 text-center sm:px-6 sm:py-32 lg:px-8">
    <p class="hero-enter hero-enter-1 text-sm font-semibold uppercase tracking-[0.2em] text-brand-300">{eyebrow}</p>
    <h1 class="hero-enter hero-enter-2 mx-auto mt-4 max-w-3xl text-4xl font-extrabold leading-tight text-white sm:text-5xl lg:text-6xl">
      {title}
    </h1>
    <p class="hero-enter hero-enter-3 mx-auto mt-6 max-w-2xl text-lg text-brand-100">{subtitle}</p>

    <div class="hero-enter hero-enter-4 mt-10 flex flex-wrap justify-center gap-4">
      <a
        href={ctaHref}
        class="rounded-full bg-white px-7 py-3.5 text-sm font-semibold text-brand-800 shadow-lg shadow-black/10 transition-transform hover:-translate-y-0.5"
      >
        {ctaLabel}
      </a>
      {secondaryLabel && secondaryHref && (
        <a
          href={secondaryHref}
          class="rounded-full border border-white/30 px-7 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-white/10"
        >
          {secondaryLabel}
        </a>
      )}
    </div>
  </div>
</section>
