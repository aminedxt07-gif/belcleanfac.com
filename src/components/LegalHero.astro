---
interface Props {
  eyebrow: string;
  title: string;
  updated: string;
}

const { eyebrow, title, updated } = Astro.props;
---

<section class="bg-brand-950 py-16">
  <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-300">{eyebrow}</p>
    <h1 class="mt-3 text-3xl font-bold text-white sm:text-4xl">{title}</h1>
    <p class="mt-3 text-sm text-brand-200">{updated}</p>
  </div>
</section>
