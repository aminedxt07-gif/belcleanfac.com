---
import { NAV_LABELS, UI, LEGAL_LABELS, COOKIE_CONSENT, path, type Locale, type PageKey } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const nav = NAV_LABELS[locale];
const t = UI[locale];
const legal = LEGAL_LABELS[locale];
const pages: PageKey[] = ['home', 'services', 'sectors', 'about', 'blog', 'contact'];
const legalPages: PageKey[] = ['legal', 'privacy', 'terms'];
const cookieManage = COOKIE_CONSENT[locale].manage;
const year = new Date().getFullYear();
---

<footer class="bg-brand-950 text-brand-100">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <div class="flex items-center gap-3">
          <img src="/images/logo-bcf.png" alt="Belgium Cleaning Facilities" class="h-9 w-9 shrink-0" />
          <span class="text-lg font-bold text-white">Belgium Cleaning Facilities</span>
        </div>
        <p class="mt-4 max-w-md text-sm leading-relaxed text-brand-200">
          {t.footerAbout}
        </p>
        <div class="mt-5 flex gap-2">
          <span class="rounded-full border border-brand-400/30 px-3 py-1 text-xs font-semibold text-brand-100">VCA</span>
          <span class="rounded-full border border-brand-400/30 px-3 py-1 text-xs font-semibold text-brand-100">UGBN/ABSU</span>
        </div>
      </div>

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-white">{nav.home === 'Home' ? 'Menu' : 'Menu'}</h2>
        <ul class="mt-4 space-y-2 text-sm">
          {pages.map((p) => (
            <li><a href={path(p, locale)} class="text-brand-200 transition-colors hover:text-white">{nav[p]}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-white">Contact</h2>
        <ul class="mt-4 space-y-2 text-sm text-brand-200">
          <li><a href={`tel:${t.phone1.replace(/\s/g, '')}`} class="hover:text-white">{t.phone1}</a></li>
          <li><a href={`tel:${t.phone2.replace(/\s/g, '')}`} class="hover:text-white">{t.phone2}</a></li>
          <li><a href={`mailto:${t.email}`} class="hover:text-white">{t.email}</a></li>
          <li class="pt-1">{t.address}</li>
          <li class="font-medium text-white">{t.coverage}</li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-4 border-t border-brand-400/10 pt-6 text-xs text-brand-300 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} Belgium Cleaning Facilities. {t.footerRights}</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        {legalPages.map((p) => (
          <li><a href={path(p, locale)} class="hover:text-white">{legal[p as 'legal' | 'privacy' | 'terms']}</a></li>
        ))}
        <li><button type="button" data-cookie-settings class="hover:text-white">{cookieManage}</button></li>
      </ul>
    </div>
    <p class="mt-4 text-xs text-brand-300">{t.footerLegal}</p>
  </div>
</footer>
