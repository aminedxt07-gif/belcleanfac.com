---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import BlogCard from '../../components/BlogCard.astro';
import { BLOG, path } from '../../i18n/config';

const locale = 'fr' as const;
const t = BLOG[locale];

const posts = (await getCollection('blog', (p) => p.data.locale === locale && !p.data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Base
  locale={locale}
  page="blog"
  pageType="CollectionPage"
  title="Blog — Conseils en nettoyage professionnel | BCF"
  description={t.description}
>
  <Fragment slot="head">
    <link rel="alternate" type="application/rss+xml" title="BCF Blog RSS" href="/blog/rss.xml" />
  </Fragment>

  <section class="bg-brand-950 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionHeading as="h1" eyebrow={t.eyebrow} title={t.title} description={t.description} light />
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      {posts.length > 0 ? (
        <div data-reveal-group class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <BlogCard
            headingLevel="h2"
              locale={locale}
              href={`${path('blog', locale)}${post.data.slug}/`}
              image={post.data.image}
              imageAlt={post.data.imageAlt}
              category={post.data.category}
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
            />
          ))}
        </div>
      ) : (
        <p class="text-center text-ink-700">{t.empty}</p>
      )}
    </div>
  </section>
</Base>
