---
import Base from '../layouts/Base.astro';
import { path, UI } from '../i18n/config';

const locale = 'fr' as const;
const t = UI[locale];
---

<Base locale={locale} page="home" title="Page introuvable | BCF" description="Cette page n'existe pas ou a été déplacée." noindex>
  <section class="bg-brand-950 py-32">
    <div class="mx-auto max-w-2xl px-4 text-center sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-300">Erreur 404</p>
      <h1 class="mt-4 text-4xl font-extrabold text-white">Cette page est introuvable</h1>
      <p class="mt-4 text-brand-100">
        Le lien est peut-être ancien ou la page a été déplacée. Retrouvez nos prestations ou contactez-nous directement.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href={path('home', locale)} class="rounded-full bg-white px-7 py-3.5 text-sm font-semibold text-brand-800">Accueil</a>
        <a href={path('services', locale)} class="rounded-full border border-white/30 px-7 py-3.5 text-sm font-semibold text-white hover:bg-white/10">Nos services</a>
        <a href={path('contact', locale)} class="rounded-full border border-white/30 px-7 py-3.5 text-sm font-semibold text-white hover:bg-white/10">{t.ctaQuote}</a>
      </div>
    </div>
  </section>
</Base>
