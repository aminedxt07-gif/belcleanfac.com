---
import Base from '../../layouts/Base.astro';
import LegalHero from '../../components/LegalHero.astro';
import { COMPANY, path } from '../../i18n/config';

const locale = 'en' as const;
---

<Base
  locale={locale}
  page="legal"
  title="Legal notice — Belgium Cleaning Facilities"
  description="Legal notice for belcleanfac.be: publisher, hosting, intellectual property and applicable law."
>
  <LegalHero eyebrow="Legal information" title="Legal notice" updated="Last updated: 1 September 2026" />

  <article class="prose-legal mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <h2>Website publisher</h2>
    <p>
      This website <strong>belcleanfac.be</strong> is published by:<br />
      <strong>{COMPANY.legalName}</strong><br />
      Legal form: {COMPANY.legalForm}<br />
      Registered office: {COMPANY.address}<br />
      Company registration number (BCE/KBO): {COMPANY.bce}<br />
      VAT number: {COMPANY.vat}<br />
      Email: <a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a><br />
      Phone: <a href={`tel:${COMPANY.phone1.replace(/\s/g, '')}`}>{COMPANY.phone1}</a>
    </p>

    <h2>Publication director</h2>
    <p>The management of {COMPANY.legalName}, at the registered office address above.</p>

    <h2>Hosting</h2>
    <p>Hosting arrangements for this website are being finalised. The host's details will be added to this page once hosting is live.</p>

    <h2>Intellectual property</h2>
    <p>
      All content on this website (text, photographs, logo, visual identity, layout) is the property of
      {COMPANY.legalName}, unless otherwise stated, and is protected by copyright and trademark law. Any
      reproduction, representation, modification or distribution, in whole or in part, without prior written
      authorisation, is prohibited and may result in legal action.
    </p>

    <h2>Accuracy of information</h2>
    <p>
      {COMPANY.legalName} makes every effort to ensure the accuracy and currency of the information published on
      this website, without being able to guarantee the absence of errors or omissions. Information and visuals
      presented are indicative and do not constitute a contractual commitment. Every service is subject to a
      specific quote.
    </p>

    <h2>Hyperlinks</h2>
    <p>
      This website may contain links to third-party websites (Google Maps, OpenStreetMap...). {COMPANY.legalName}
      has no control over these websites and disclaims all responsibility for their content.
    </p>

    <h2>Applicable law</h2>
    <p>
      This website and this legal notice are governed by Belgian law. In the event of a dispute, and failing an
      amicable resolution, the courts of the judicial district of the company's registered office shall have
      exclusive jurisdiction, subject to any mandatory legal provisions to the contrary.
    </p>

    <h2>Contact</h2>
    <p>
      For any question regarding this legal notice, you may contact us at
      <a href={`mailto:${COMPANY.email}`}> {COMPANY.email}</a> or consult our
      <a href={path('privacy', locale)}>privacy policy</a> and our
      <a href={path('terms', locale)}>terms and conditions</a>.
    </p>
  </article>
</Base>
