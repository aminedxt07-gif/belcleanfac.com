---
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import AltSection from '../../components/AltSection.astro';
import StatBanner from '../../components/StatBanner.astro';
import CTABanner from '../../components/CTABanner.astro';
import Icon from '../../components/Icon.astro';
import { path, UI } from '../../i18n/config';

const locale = 'en' as const;
const t = UI[locale];

const stats = [
  { value: '20+', label: 'years of expertise' },
  { value: '100%', label: 'of Belgium covered' },
  { value: 'VCA', label: 'safety certification' },
  { value: 'ISO 9000', label: 'quality certification' },
];

const equipment = [
  { icon: 'truck', title: 'Boom truck', description: 'For cleaning windows and facades at great height, safely.' },
  { icon: 'building', title: 'Scissor lift', description: 'For interventions on facades and technical surfaces at medium height.' },
  { icon: 'droplet', title: 'Karcher truck', description: 'High-pressure cleaning of facades, floors and outdoor surfaces.' },
  { icon: 'spark', title: 'Large-surface scrubber', description: 'Fast, efficient upkeep of warehouse floors and large surfaces.' },
  { icon: 'pole', title: 'Reverse-osmosis water system', description: 'Telescopic poles and demineralised water for streak-free window cleaning, from the ground.' },
  { icon: 'blaster', title: 'IBIX sandblaster', description: 'Gentle, precise blasting to remove graffiti without damaging surfaces.' },
  { icon: 'steam', title: 'Steam cleaning machine', description: 'High-temperature cleaning and disinfection, without chemical products.' },
  { icon: 'carpet', title: 'Injection/extraction machine', description: 'Deep cleaning of carpets and rugs using injection-extraction.' },
];
---

<Base
  locale={locale}
  page="about"
  title="About BCF — Belgium Cleaning Facilities"
  description="Since 1998, expertise in professional cleaning, VCA and ISO 9000 certified, active across Belgium."
>
  <section class="bg-brand-950 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="About BCF"
        title="Since 1998, recognised expertise in professional cleaning"
        description="Belgium Cleaning Facilities supports businesses across Belgium with professional equipment suited to every situation and a qualified team, trained for the requirements of industrial and sensitive environments."
        light
      />
    </div>
  </section>

  <StatBanner stats={stats} />

  <AltSection
    image="/images/elevateur-ciseau-intervention.jpg"
    eyebrow="Our team"
    title="A qualified team, trained for demanding environments"
    description="Our teams work daily on industrial, hospital, hotel and university sites. VCA-certified, they understand the safety requirements specific to each environment and adapt to each client's constraints: occupied sites, shifted hours, sensitive areas."
    points={[
      'VCA certification for interventions in industrial environments',
      'ISO 9000 quality certification',
      'Teams trained in professional equipment and safety procedures',
      'Availability adapted to the constraints of each site',
    ]}
  />

  <section class="bg-brand-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="Our equipment"
        title="Continuous investment in professional equipment"
        description="To work safely, whatever the height or surface to be treated."
      />
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {equipment.map((e) => (
          <div class="rounded-2xl border border-ink-900/5 bg-white p-6">
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-brand-600 text-white">
              <Icon name={e.icon} class="h-6 w-6" />
            </div>
            <h3 class="mt-4 text-base font-bold text-ink-900">{e.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-700">{e.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <AltSection
    image="/images/certif-VCA.jpg"
    eyebrow="Certifications"
    title="Certifications recognised by our professional clients"
    description="Our VCA and ISO 9000 certifications guarantee our clients a level of safety and quality that meets the requirements of industrial, hospital and institutional environments."
    points={[
      'VCA — safety, health and environment on site',
      'ISO 9000 — quality management system',
      'Member of UGBN/ABSU, the professional federation for the cleaning industry in Belgium',
      'Professional insurance suited to our activities',
      'Across Belgium, with a home base in Londerzeel',
    ]}
    reverse
    ctaLabel={t.ctaQuote}
    ctaHref={path('contact', locale)}
  />

  <CTABanner
    title="Let's talk about your site"
    description="Our team reviews every request to propose the solution best suited to your business."
    ctaLabel={t.ctaQuote}
    ctaHref={path('contact', locale)}
    phoneLabel={t.ctaCall}
    phone={t.phone1}
  />
</Base>
