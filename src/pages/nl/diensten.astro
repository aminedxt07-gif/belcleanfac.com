---
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import AltSection from '../../components/AltSection.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import CTABanner from '../../components/CTABanner.astro';
import { path, UI } from '../../i18n/config';
import FAQ from '../../components/FAQ.astro';
import { HOME_FAQ, SERVICES_FAQ } from '../../i18n/faq';
import { faqNode, serviceNodes, SITE } from '../../i18n/seo';
import { SERVICE_PATHS, SERVICE_UI } from '../../i18n/service-pages';
import { PATHS } from '../../i18n/config';

const locale = 'nl' as const;
const t = UI[locale];
const faq = SERVICES_FAQ[locale];
const pageUrl = new URL(PATHS.services[locale], SITE).toString();
const schema = [...serviceNodes(locale, pageUrl, [{"anchor": "vitres-facades", "name": "Ramen- en gevelreiniging op hoogte", "description": "Ramen wassen met telescopische stangen, osmosewater, hoogwerkers en hoogwerkervrachtwagen; reiniging van kozijnen, zandstralen van gevels, daken ontmossen en graffiti verwijderen.", "serviceType": "Window and facade cleaning"}, {"anchor": "surfaces", "name": "Industriële reiniging van vloeren en grote oppervlakken", "description": "Grote schrobzuigmachines en hogedrukmateriaal voor vloeren van magazijnen, industriehallen, parkings en tertiaire ruimtes.", "serviceType": "Industrial floor cleaning"}, {"anchor": "osmose", "name": "Ramen wassen met osmosewater", "description": "Reiniging met gedemineraliseerd water en telescopische stangen: ramen, veranda's en glazen gevels streeploos vanaf de grond, zonder detergent.", "serviceType": "Pure water (reverse-osmosis) window cleaning"}, {"anchor": "batiments", "name": "Onderhoud van tertiaire, residentiële en evenementiële gebouwen", "description": "Regelmatig of eenmalig onderhoud van kantoren, studentenresidenties, musea en evenementiële gebouwen, inclusief reiniging na de bouw.", "serviceType": "Building maintenance cleaning"}]), faqNode(pageUrl, faq.items)];
---

<Base
  locale={locale}
  page="services"
  schema={schema}
  title="Ramen-, gevel- en industriële vloerreiniging | BCF"
  description="Ramen en gevels op hoogte, industriële vloeren, reiniging met osmosewater, gebouwreiniging: ontdek alle professionele reinigingsdiensten van BCF."
>
  <section class="bg-brand-950 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionHeading as="h1"
        eyebrow="Onze diensten"
        title="Een volledige knowhow in professionele reiniging"
        description="BCF is actief op elk type site voor bedrijven: ramen en gevels op hoogte, industriële vloeren, reiniging met osmosewater en gebouwonderhoud, overal in België."
        light
      />
    </div>
  </section>

  <AltSection
    id="vitres-facades"
    moreHref={SERVICE_PATHS.windows[locale]}
    moreLabel={SERVICE_UI[locale].learnMore}
    image="/images/vitres-facade-nacelle-chenilles.jpg"
    eyebrow="Ramen & gevels"
    title="Onberispelijke reiniging, zelfs op hoogte"
    description="Wij reinigen ramen met professioneel materiaal aangepast aan elke configuratie: telescopische stangen en osmosewater-systemen voor een streeploos resultaat, hoogwerkers en hoogwerkwagen voor moeilijk bereikbare plaatsen."
    points={[
      'Inclusief wassen van kozijnen en omlijstingen',
      'Gevelreiniging op hoogte (baksteen, steen, beton)',
      'Mosverwijdering en dakreiniging',
      'Verwijderen van graffiti met zachte reinigingstechnieken',
    ]}
    ctaLabel={t.ctaQuote}
    ctaHref={path('contact', locale)}
  />

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="Concreet resultaat"
        title="Voor / na: reiniging van een industriële gevel"
        description="Sleep de schuifregelaar om te vergelijken."
      />
      <div class="mt-12">
        <BeforeAfter
          before="/images/facade-avant-nettoyage.jpg"
          after="/images/facade-apres-nettoyage.jpg"
          beforeLabel="Voor"
          afterLabel="Na"
        />
      </div>
    </div>
  </section>

  <AltSection
    id="surfaces"
    moreHref={SERVICE_PATHS.floors[locale]}
    moreLabel={SERVICE_UI[locale].learnMore}
    image="/images/autolaveuse-entrepot-hoogwerkers.jpg"
    eyebrow="Vloeren & grote oppervlakken"
    title="Industriële reiniging van vloeren en grote oppervlakken"
    description="Schrobmachines voor grote oppervlakken en hogedrukmateriaal voor het onderhoud van magazijnvloeren, binnen- en buitenparkings, en tertiaire en administratieve ruimtes."
    points={[
      'Ontvetten en onderhoud van betonvloeren',
      'Magazijnen, industriële hallen en productiezones',
      'Parkings en parkeerzones, binnen en buiten',
      'Kantoren en tertiaire & administratieve ruimtes',
    ]}
    reverse
    tint
    ctaLabel={t.ctaQuote}
    ctaHref={path('contact', locale)}
  />

  <AltSection
    id="osmose"
    moreHref={SERVICE_PATHS.osmosis[locale]}
    moreLabel={SERVICE_UI[locale].learnMore}
    image="/images/nettoyage-vitres-perche-eau-osmosee.jpg"
    eyebrow="Reiniging met osmosewater"
    title="Streeploze ramen, zelfs op hoogte, zonder chemische producten"
    description="Ons reinigingssysteem met osmosewater (gedemineraliseerd water) verwijdert kalk en resten voor een onberispelijk en duurzaam resultaat. In combinatie met telescopische stangen reinigen we ramen, serres en glazen gevels op hoogte rechtstreeks vanaf de grond, zonder hoogwerker of stelling."
    points={[
      'Osmosewater / gedemineraliseerd water: geen strepen, geen kalkresten',
      'Telescopische stangen tot enkele tientallen meters vanaf de grond',
      'Reiniging zonder detergent, veilig voor gevoelige oppervlakken',
      'Ideaal voor etalages, serres, luifels en moeilijk bereikbare glazen gevels',
    ]}
    ctaLabel={t.ctaQuote}
    ctaHref={path('contact', locale)}
  />

  <AltSection
    id="batiments"
    moreHref={SERVICE_PATHS.buildings[locale]}
    moreLabel={SERVICE_UI[locale].learnMore}
    image="/images/autolaveuse-hall-musee-evenementiel.jpg"
    eyebrow="Gebouwen & collectieve residenties"
    title="Onderhoud van tertiaire, residentiële en evenementengebouwen"
    description="Wij verzorgen het regelmatige of occasionele onderhoud van kantoren, studentenresidenties, musea en evenementengebouwen, met teams opgeleid voor de vereisten van elke omgeving."
    points={[
      'Kantoren en tertiaire gebouwen',
      'Studentenresidenties en collectieve woningen',
      'Musea en evenementengebouwen',
      'Regelmatig onderhoud of occasionele reiniging na werken',
    ]}
    reverse
    tint
    ctaLabel={t.ctaQuote}
    ctaHref={path('contact', locale)}
  />

  <FAQ eyebrow={faq.eyebrow} title={faq.title} description={faq.description} items={faq.items} tint />

  <CTABanner
    title="Een dienst op maat van uw site"
    description="Elke site is anders: laten we uw behoeften bespreken om een aangepast voorstel te bouwen."
    ctaLabel={t.ctaQuote}
    ctaHref={path('contact', locale)}
    phoneLabel={t.ctaCall}
    phone={t.phone1}
  />
</Base>
