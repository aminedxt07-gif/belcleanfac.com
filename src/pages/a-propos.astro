---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import AltSection from '../components/AltSection.astro';
import StatBanner from '../components/StatBanner.astro';
import CTABanner from '../components/CTABanner.astro';
import Icon from '../components/Icon.astro';
import { path, UI } from '../i18n/config';

const locale = 'fr' as const;
const t = UI[locale];

const stats = [
  { value: '20+', label: "ans d'expertise" },
  { value: '100%', label: 'Belgique couverte' },
  { value: 'VCA', label: 'certification sécurité' },
  { value: 'UGBN/ABSU', label: 'fédération professionnelle' },
];

const equipment = [
  { icon: 'truck', title: 'Camion élévateur', description: "Pour le nettoyage de vitres et façades en grande hauteur, en toute sécurité." },
  { icon: 'building', title: 'Élévateur ciseau', description: 'Pour les interventions sur façades et surfaces techniques à hauteur moyenne.' },
  { icon: 'droplet', title: 'Camion Karcher', description: 'Nettoyage haute pression de façades, sols et surfaces extérieures.' },
  { icon: 'spark', title: 'Autolaveuse grande surface', description: "Entretien rapide et efficace des sols d'entrepôts et de grandes surfaces." },
  { icon: 'pole', title: "Système d'eau osmosée", description: "Perches télescopiques et eau déminéralisée pour un nettoyage de vitres sans traces, depuis le sol." },
  { icon: 'blaster', title: 'Sableuse IBIX', description: "Sablage doux et précis pour l'élimination des graffitis sans endommager les supports." },
  { icon: 'steam', title: 'Machine à vapeur', description: 'Nettoyage et désinfection à haute température, sans produits chimiques.' },
  { icon: 'carpet', title: 'Injection/extraction', description: 'Nettoyage en profondeur des tapis et moquettes par injection-extraction.' },
];
---

<Base
  locale={locale}
  page="about"
  pageType="AboutPage"
  title="À propos de BCF — Belgium Cleaning Facilities"
  description="Depuis 1998, une expertise en nettoyage professionnel certifiée VCA, active dans toute la Belgique."
>
  <section class="bg-brand-950 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionHeading as="h1"
        eyebrow="À propos de BCF"
        title="Depuis 1998, une expertise reconnue en nettoyage professionnel"
        description="Belgium Cleaning Facilities accompagne les entreprises dans toute la Belgique avec un matériel professionnel adapté à chaque situation et une équipe qualifiée, formée aux exigences des environnements industriels et sensibles."
        light
      />
    </div>
  </section>

  <StatBanner stats={stats} />

  <AltSection
    image="/images/elevateur-ciseau-intervention.jpg"
    eyebrow="Notre équipe"
    title="Une équipe qualifiée, formée aux environnements exigeants"
    description="Nos équipes interviennent quotidiennement sur des sites industriels, hospitaliers, hôteliers et universitaires. Certifiées VCA, elles connaissent les exigences de sécurité propres à chaque environnement et s'adaptent aux contraintes de chaque client : site occupé, horaires décalés, zones sensibles."
    points={[
      'Certification VCA pour les interventions en environnement industriel',
      'Équipes formées au matériel professionnel et aux consignes de sécurité',
      'Disponibilité adaptée aux contraintes de chaque site',
    ]}
  />

  <section class="bg-brand-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="Notre matériel"
        title="Un investissement continu dans du matériel professionnel"
        description="Pour intervenir en toute sécurité, quelle que soit la hauteur ou la surface à traiter."
      />
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {equipment.map((e) => (
          <div class="rounded-2xl border border-ink-900/5 bg-white p-6">
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-brand-600 text-white">
              <Icon name={e.icon} class="h-6 w-6" />
            </div>
            <h3 class="mt-4 text-base font-bold text-ink-900">{e.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-700">{e.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <AltSection
    image="/images/certif-VCA.jpg"
    eyebrow="Certifications"
    title="Des certifications reconnues par nos clients professionnels"
    description="Notre certification VCA garantit à nos clients un niveau de sécurité conforme aux exigences des environnements industriels, hospitaliers et institutionnels."
    points={[
      'VCA — sécurité, santé et environnement sur les chantiers',
      "Membre de l'UGBN/ABSU, la fédération professionnelle du secteur du nettoyage en Belgique",
      'Assurances professionnelles adaptées à nos activités',
      'Toute la Belgique, avec un point d’ancrage à Londerzeel',
    ]}
    reverse
    ctaLabel={t.ctaQuote}
    ctaHref={path('contact', locale)}
  />

  <CTABanner
    title="Parlons de votre site"
    description="Notre équipe étudie chaque demande pour proposer la solution la plus adaptée à votre activité."
    ctaLabel={t.ctaQuote}
    ctaHref={path('contact', locale)}
    phoneLabel={t.ctaCall}
    phone={t.phone1}
  />
</Base>
